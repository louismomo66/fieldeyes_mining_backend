# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_strong_db_password
DB_NAME=mining_data
DSN=

# DB Connection Pool (tune to your server size)
# Small VPS (2 CPU):  OPEN=50,  IDLE=10, LIFETIME=1800, IDLE_TIME=300
# Medium (4 CPU):     OPEN=100, IDLE=20
# Large (8+ CPU):     OPEN=200, IDLE=40
MAX_DB_OPEN_CONNS=200
MAX_DB_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=1800
DB_CONN_MAX_IDLE_TIME=300

# JWT Configuration
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Admin self-registration code (leave blank to disable admin self-registration)
# Generate with: openssl rand -hex 16
ADMIN_REGISTRATION_CODE=change_me_or_leave_blank_to_disable

# Server Configuration
PORT=9006

# CORS — comma-separated list of allowed frontend origins
# Example: https://app.fieldeyes.com,https://admin.fieldeyes.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email Configuration (for OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com

# Redis Configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_DB=0

# Application Configuration
APP_ENV=development
APP_DEBUG=false
